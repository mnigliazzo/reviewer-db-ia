# Copiá este archivo a .env y completá los valores.
# Lo usan: run.py (subconjunto), el Makefile / make.ps1 y docker-compose.yml.
# NO uses comentarios al final de una línea de valor: el parser no los quita y
# quedarían dentro del valor. Comentarios siempre en su propia línea.

# -- LLM Provider --
# Opciones: ollama | openai | openrouter | groq
PROVIDER=ollama
MODEL_BASE_URL=http://localhost:11434
MODEL_AGENT=qwen2.5-coder
# API_KEY=            requerido para openai / openrouter / groq
OLLAMA_CONTEXT_LENGTH=16384

# -- Reviewer --
LOG_LEVEL=INFO
# 0 = ilimitado
REVIEWER_MAX_SCHEMA_SCRIPTS=10
# SKIP_REPORTER=0
# Prioridades que hacen fallar el pipeline (CSV): CRÍTICO,ALTO,MEDIO,BAJO,MEJORA,OBSERVACION
REVIEWER_FAIL_ON=CRÍTICO
# Timeout por llamada al LLM, en segundos
REVIEWER_LLM_TIMEOUT=120
# Reintentos por llamada al LLM ante error transitorio
REVIEWER_LLM_RETRIES=2
# Ruta del reporte SARIF 2.1.0 (vacío / sin definir = no se genera)
# REVIEWER_SARIF=./reviewer.sarif.json

# Modo de `make run`:  docker (dentro del contenedor) | local (CLI en el venv, via run.py).
# Se puede pisar en línea de comandos:  make run MODE=local
MODE=docker

# Carpeta con los scripts a revisar. Son dos claves distintas, no alias:
#   SCRIPTS_PATH        -> lo consume el CLI (run.py). En docker el valor lo fija
#                          el Dockerfile (/app/scripts_review), no hace falta acá.
#   REVIEW_SCRIPTS_PATH -> solo docker-compose: carpeta del host que se monta en
#                          /app/scripts_review.
SCRIPTS_PATH=./tmp/db-script
REVIEW_SCRIPTS_PATH=./tmp/db-script

# -- Docker registry / proxy (solo make + docker-compose) --
DOCKER_REGISTRY=registry.doj.si.corp
DOCKER_REGISTRY_PULL_PORT=8082
DOCKER_REGISTRY_PUSH_PORT=8084
VOLUME_OLLAMA=ollama_data
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# -- Solo `make prepare-delta` (clona el repo db-scripts) --
REPO_URL=https://gitlab.doj.si.corp/pi/database/db-scripts.git
GIT_BRANCH=develop
GIT_USERNAME=
# contraseña en base64
GIT_PASSWORD=
